{
  "name": "@masatomakino/state-atoms",
  "version": "0.3.1",
  "description": "StateAtoms is a lightweight state management library for TypeScript.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsc",
    "lint": "biome check .",
    "pre-commit": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "pre-push": "pnpm run build --noEmit && vitest --run && biome ci ."
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasatoMakino/StateAtoms.git"
  },
  "author": "MasatoMakino <makino.masato.g@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MasatoMakino/StateAtoms/issues"
  },
  "homepage": "https://github.com/MasatoMakino/StateAtoms#readme",
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@vitest/coverage-istanbul": "^5.0.2",
    "eventemitter3": "^5.0.1",
    "fast-equals": "^6.0.4",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "eventemitter3": "^5.0.1",
    "fast-equals": "^6.0.4"
  }
}
