#!/bin/bash
# Git runs on the host; the formatter runs in the DevContainer of this working tree.
exec 1>&2

# npm passes the arguments after `--` to the script.
RUN_SCRIPT=(npm run pre-commit --)

# Each worktree has its own DevContainer. The devcontainer CLI labels it with the folder path.
ROOT="$(git rev-parse --show-toplevel)"
if [ -z "$(docker ps -q --filter "label=devcontainer.local_folder=$ROOT")" ]; then
  echo "[pre-commit] DevContainer not running. Starting..."
  devcontainer up --workspace-folder "$ROOT" || exit 1
fi

cd "$ROOT" || exit 1

STAGED=()
while IFS= read -r file; do
  STAGED+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ ${#STAGED[@]} -eq 0 ]; then
  exit 0
fi

if ! devcontainer exec --workspace-folder "$ROOT" "${RUN_SCRIPT[@]}" "${STAGED[@]}"; then
  echo "[pre-commit] ERROR: code quality checks failed"
  exit 1
fi

for file in "${STAGED[@]}"; do
  if [ -f "$file" ]; then
    git add -- "$file" || exit 1
  fi
done

exit 0
