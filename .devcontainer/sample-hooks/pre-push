#!/bin/bash
# Git runs on the host; tests run in the DevContainer of this working tree.
exec 1>&2

RUN_SCRIPT=(pnpm run pre-push)

# Each worktree has its own DevContainer. The devcontainer CLI labels it with the folder path.
ROOT="$(git rev-parse --show-toplevel)"
if [ -z "$(docker ps -q --filter "label=devcontainer.local_folder=$ROOT")" ]; then
  echo "[pre-push] DevContainer not running. Starting..."
  devcontainer up --workspace-folder "$ROOT" || exit 1
fi

if ! devcontainer exec --workspace-folder "$ROOT" "${RUN_SCRIPT[@]}"; then
  echo "[pre-push] ERROR: tests or CI checks failed"
  exit 1
fi

exit 0
